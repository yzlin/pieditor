{
  "name": "@yzlin/pieditor",
  "version": "1.0.0",
  "description": "Pi editor extension with enhanced editor, file picker, shell completions, and status bar.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yzlin/pieditor"
  },
  "files": [
    "src",
    "native/syntect-picker-preview/index.js",
    "native/syntect-picker-preview/index.d.ts",
    "native/syntect-picker-preview/package.json",
    "native/syntect-picker-preview/*.node",
    "configuration_schema.json",
    "config.json.example",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": "./configuration_schema.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:syntect-picker-preview": "node native/syntect-picker-preview/scripts/build.mjs",
    "check": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mariozechner/clipboard": "^0.3.5",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/bun": "^1.2.23",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "typebox": "^1.1.34"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "configuration": "./configuration_schema.json"
  }
}
