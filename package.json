{
  "name": "@yzlin/pieditor",
  "version": "1.0.0",
  "description": "Pi editor extension with enhanced editor, file picker, shell completions, and status bar.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./replacement-surface-lease": {
      "types": "./types/replacement-surface-lease.d.ts",
      "import": "./dist/replacement-surface-lease.js"
    },
    "./schema": "./schema/configuration_schema.json"
  },
  "files": [
    "dist",
    "types",
    "schema",
    "configuration_schema.json",
    "config.json.example",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "configuration": "./schema/configuration_schema.json"
  },
  "scripts": {
    "build": "bun run clean && tsc -p tsconfig.json && bun run scripts/copy-assets.mjs",
    "build:syntect-picker-preview": "node native/syntect-picker-preview/scripts/build.mjs",
    "check": "biome check .",
    "clean": "rm -rf dist types schema"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.74.0",
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "@earendil-works/pi-tui": "^0.74.0",
    "typebox": "^1.1.34"
  },
  "dependencies": {
    "@mariozechner/clipboard": "^0.3.5",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/bun": "^1.2.23",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
